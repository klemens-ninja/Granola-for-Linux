+// updateHook(fn | null): calls fn(operation, databaseName, tableName, rowid)
+// after every row INSERT/UPDATE/DELETE on this connection. Pass null/undefined
+// to remove the hook. Exceptions thrown by fn are swallowed.
+NODE_METHOD(Database::JS_updateHook) {
+	Database* db = Unwrap<Database>(info.This());
+	if (!db->open) return ThrowTypeError("The database connection is not open");
+	if (info.Length() == 0 || info[0]->IsNull() || info[0]->IsUndefined()) {
+		sqlite3_update_hook(db->db_handle, NULL, NULL);
+		db->update_hook.Reset();
+		return;
+	}
+	if (!info[0]->IsFunction()) return ThrowTypeError("Expected first argument to be a function");
+	db->update_hook.Reset(info.GetIsolate(), info[0].As<v8::Function>());
+	sqlite3_update_hook(db->db_handle, UpdateHookCallback, db);
+}
+
+void Database::UpdateHookCallback(void* ctx, int op, const char* db_name, const char* table, sqlite3_int64 rowid) {
+	Database* db = static_cast<Database*>(ctx);
+	if (db->update_hook.IsEmpty()) return;
+	v8::Isolate* isolate = v8::Isolate::GetCurrent();
+	v8::HandleScope scope(isolate);
+	v8::Local<v8::Context> ctx_ = isolate->GetCurrentContext();
+	const char* op_name = op == SQLITE_INSERT ? "insert" : op == SQLITE_DELETE ? "delete" : "update";
+	v8::Local<v8::Value> args[4] = {
+		StringFromUtf8(isolate, op_name, -1),
+		StringFromUtf8(isolate, db_name, -1),
+		StringFromUtf8(isolate, table, -1),
+		v8::Number::New(isolate, static_cast<double>(rowid))
+	};
+	v8::TryCatch try_catch(isolate);
+	(void)db->update_hook.Get(isolate)->Call(ctx_, v8::Undefined(isolate), 4, args);
+}
+
 NODE_GETTER(Database::JS_open) {
 	info.GetReturnValue().Set(Unwrap<Database>(PROPERTY_HOLDER(info))->open);
 }
